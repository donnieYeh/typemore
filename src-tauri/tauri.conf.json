{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typemore",
  "version": "0.1.0",
  "identifier": "com.typemore.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typemore",
        "label": "main",
        "width": 1120,
        "height": 780,
        "visible": true,
        "resizable": true
      },
      {
        "title": "Typemore Overlay",
        "label": "overlay",
        "width": 360,
        "height": 132,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
